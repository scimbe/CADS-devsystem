# Origin for the devsystem-demo.bunsenbrenner.org demo (CADS-Tunnel #382). Caddy
# terminates TLS and serves the static status page directly -- no backend bridge.
#
# Unlike the other demo repos' Caddyfiles, this hostname was provisioned through
# CADS-Tunnel's normal, tracked POST /admin/provision-tunnel path (real
# subject_tunnels row, real routing token) -- NOT scripts/authorize-pipeline.sh's
# headless enroll/issue path, which would mint a SECOND, conflicting token for
# the same hostname (the exact bug class filed as CADS-Tunnel#385). The cert
# here is a locally-generated self-signed one: sufficient for once this tunnel
# reaches Grün (own cert, real SNI passthrough) -- while it's Gelb (the
# default for a freshly provisioned tunnel, this deployment's current state)
# the edge terminates the customer-facing TLS itself with its shared wildcard
# cert and forwards PLAINTEXT to the origin, so this Caddyfile serves plain
# HTTP on :443, not TLS -- `tls ...` here would make Caddy reject the edge's
# forwarded plaintext as a protocol mismatch ("Client sent an HTTP request to
# an HTTPS server"). Switch back to `tls /certs/fullchain.pem /certs/privkey.pem`
# once `ct-agent certificate` promotes this tunnel to Grün.
{
	auto_https off
}

:443 {
	# CADS-Tunnel#388 gap 1: a headless CLI (devsystem_offer) has no browser, no
	# cookie jar, no way to complete an interactive Keycloak login -- and doesn't
	# need one here. A CapacityOffer's own real ed25519 signature, verified
	# server-side by submit_offer before it's ever accepted, IS the
	# authentication for this one endpoint; a session cookie on top verifies
	# nothing a forged offer wouldn't already fail on via signature
	# verification, while fully blocking the exact headless case this exists
	# for. Agreed in the issue thread (bob-1 + the external-agent reply, both
	# independently landing on this same option (a) over a separate un-gated
	# intake path (b), since (b) is strictly more surface for the same
	# outcome). Scoped tightly to POST .../offers/submit specifically -- NOT a
	# blanket /api/* exemption: every other endpoint here is a real GUI/human
	# action (iterate, checkin, pause/resume, role fill-mode, ...) with no
	# signature of its own, and stays behind the gate.
	@offers_submit {
		method POST
		path_regexp ^/api/runs/[^/]+/offers/submit$
	}
	handle @offers_submit {
		reverse_proxy devsystem-web:8790
	}

	handle {
		# The gate's own /gate/check issues the login redirect itself when it's
		# needed (a 302 straight to /gate/start) -- Caddy's forward_auth copies
		# that response to the client verbatim. No handle_errors block needed
		# (an earlier version of this Caddyfile had one; it never actually fired --
		# forward_auth never routes a non-2xx auth response through Caddy's error
		# pipeline at all, confirmed against Caddy's own forward_auth docs).
		forward_auth https://{$CT_GATE_UPSTREAM_HOST} {
			uri /gate/check
			copy_headers X-Gate-Email
		}
		# devsystem-web (a real axum backend, #382) replaces the plain file_server here --
		# the page it serves is now a real control panel (list/view/drive pipeline runs),
		# not a static status page. Confirmed 100% static with zero interactivity before
		# this change; see the devsystem-web commit for how that was verified.
		reverse_proxy devsystem-web:8790
	}

	encode gzip
	header {
		X-Content-Type-Options "nosniff"
	}
}
